{
  "version": 1,
  "rules": [
    {
      "id": "contract-schema",
      "severity": "error",
      "enabled": true,
      "check": "file-exists",
      "path": "docs/site-data.schema.json"
    },
    {
      "id": "contract-documentation",
      "severity": "error",
      "enabled": true,
      "check": "file-exists",
      "path": "docs/site-data-contract.md"
    },
    {
      "id": "architecture-decision",
      "severity": "error",
      "enabled": true,
      "check": "file-exists",
      "path": "docs/adr/0001-github-pages-site.md"
    },
    {
      "id": "contract-version",
      "severity": "error",
      "enabled": true,
      "check": "json-contract",
      "path": "docs/site-data.schema.json",
      "schemaVersion": 1
    },
    {
      "id": "site-data-domains",
      "severity": "error",
      "enabled": true,
      "check": "site-data",
      "dataPath": "build/site-data.json"
    },
    {
      "id": "documentation-index-links",
      "severity": "error",
      "enabled": true,
      "check": "local-links",
      "path": "docs/index.md"
    },
    {
      "id": "site-contract-determinism",
      "severity": "error",
      "enabled": true,
      "check": "text-contains",
      "path": "docs/site-data-contract.md",
      "text": "validators must not read the wall clock or access the network"
    },
    {
      "id": "website-index-exists",
      "severity": "error",
      "enabled": true,
      "check": "file-exists",
      "path": "website/index.html"
    },
    {
      "id": "website-index-links",
      "severity": "error",
      "enabled": true,
      "check": "local-links",
      "path": "website/index.html"
    },
    {
      "id": "pages-workflow-exists",
      "severity": "error",
      "enabled": true,
      "check": "file-exists",
      "path": ".github/workflows/pages.yml"
    },
    {
      "id": "website-base-path",
      "severity": "error",
      "enabled": true,
      "check": "text-contains",
      "path": "website/index.html",
      "text": "<base href=\"./\">"
    }
  ]
}
