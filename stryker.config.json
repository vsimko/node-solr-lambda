{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "typescriptChecker": {
    "prioritizePerformanceOverAccuracy": true
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/transport.ts",
    "src/apis/update.ts",
    "src/apis/collections.ts",
    "src/apis/core-admin.ts"
  ],
  "concurrency": 2,
  "timeoutMS": 120000,
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "html", "json"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
